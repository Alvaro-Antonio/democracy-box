# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Variáveis NEXT_PUBLIC_* são expostas ao navegador: nunca coloque segredos nelas.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente servidor (NUNCA prefixe com NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# E-mails de administradores separados por vírgula
ADMIN_EMAILS=admin@example.com

# Envio de comprovante de voto por e-mail (Opcional - usa Resend REST API)
# Se não configurado, os comprovantes são gerados no console do servidor em desenvolvimento
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="Democracy Box <onboarding@resend.dev>"
